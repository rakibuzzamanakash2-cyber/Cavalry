# Copy to .env.local and fill in. Never commit real values.

# Neon → your project → Connect.
# App runtime: the POOLED string (hostname contains "-pooler").
DATABASE_URL="postgresql://<user>:<password>@ep-<name>-pooler.<region>.aws.neon.tech/neondb?sslmode=require"
# Migrations and seeding: the DIRECT string (same, without "-pooler").
DIRECT_URL="postgresql://<user>:<password>@ep-<name>.<region>.aws.neon.tech/neondb?sslmode=require"
# Optional: only for `npm run db:migrate:dev` if Prisma can't create its own scratch database.
# SHADOW_DATABASE_URL=""


# Accounts (Better Auth)
# Generate a secret with: npx @better-auth/cli secret   (or any 32+ random characters)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated founder emails. They become admins automatically when they
# first sign in with a verified email (e.g. Google). Others: npm run user:role
ADMIN_EMAILS=""
# Optional: Google sign-in (Google Cloud Console → Credentials → OAuth client ID).
# Authorised redirect URI: <site URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public site settings
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_LINKEDIN_URL=""
NEXT_PUBLIC_GITHUB_URL=""
