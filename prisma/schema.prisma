// CAVALRY research — database schema (PostgreSQL on Neon).
// After editing: `npm run db:migrate:dev -- --name <change>` and commit prisma/migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  planning
  active
  completed
  paused
}

enum OutputType {
  working_paper
  journal_article
  preprint
  dataset
  software
  policy_brief
}

enum OutputStatus {
  in_preparation
  under_review
  published
}

enum Visibility {
  public
  members
}

enum ApplicationStatus {
  pending
  accepted
  rejected
  withdrawn
}

// ---------------------------------------------------------------------------
// Accounts (Better Auth). Field names follow Better Auth's Prisma schema.
// role: "user" (signed in), "member" (researcher) or "admin".
// ---------------------------------------------------------------------------

model User {
  id                  String               @id
  name                String
  email               String               @unique
  emailVerified       Boolean              @default(false) @map("email_verified")
  image               String?
  role                String               @default("user")
  /// Permanent account ID such as CAV00012, given at sign-up. Works for sign-in.
  uid                 String               @unique @default(dbgenerated("('CAV'::text || lpad((nextval('user_uid_seq'::regclass))::text, 5, '0'::text))"))
  /// Optional sign-in name the person chooses (lowercase). Works for sign-in.
  username            String?              @unique
  sessions            Session[]
  accounts            Account[]
  applications        Application[]        @relation("applicant")
  reviews             Application[]        @relation("reviewer")
  ledProjects         Project[]            @relation("leader")
  memberships         ProjectMembership[]  @relation("membershipUser")
  ratingsGiven        ProjectMembership[]  @relation("ratedBy")
  datasetsAdded       Dataset[]
  slotRequestsMade    ProjectSlotRequest[] @relation("slotRequester")
  slotRequestsDecided ProjectSlotRequest[] @relation("slotDecider")
  invitesSent         ProjectInvite[]      @relation("inviteCreator")
  invitesUsed         ProjectInvite[]      @relation("inviteAcceptor")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}

/// People shown on the Team page.
model TeamMember {
  id          String          @id @default(uuid()) @db.Uuid
  slug        String          @unique
  name        String
  role        String
  focus       String
  bio         String
  photoUrl    String?         @map("photo_url")
  email       String?
  linkedinUrl String?         @map("linkedin_url")
  githubUrl   String?         @map("github_url")
  scholarUrl  String?         @map("scholar_url")
  isFounder   Boolean         @default(false) @map("is_founder")
  isActive    Boolean         @default(true) @map("is_active")
  sortOrder   Int             @default(0) @map("sort_order")
  projects    ProjectMember[]
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive, sortOrder])
  @@map("team_members")
}

/// Open member roles listed on the Team page.
model OpenRole {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  title      String
  background String
  owns       String
  isOpen     Boolean  @default(true) @map("is_open")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("open_roles")
}

/// Research programmes. Structured lists (sub-questions, data sources, stages,
/// ...) are JSON columns validated in src/data/programmes.ts.
model Project {
  id           String               @id @default(uuid()) @db.Uuid
  slug         String               @unique
  number       String
  label        String
  title        String
  summary      String
  question     String
  status       ProjectStatus        @default(planning)
  statusLabel  String               @map("status_label")
  currentStage Int                  @default(0) @map("current_stage")
  leads        String[]
  areas        String[]
  whyItMatters Json                 @map("why_it_matters")
  subQuestions Json                 @map("sub_questions")
  design       Json
  dataSources  Json                 @map("data_sources")
  approach     Json
  scopes       Json
  stages       Json
  outputs      Json
  commitments  Json
  highlights   Json /// short facts for the home page card
  isFeatured   Boolean              @default(false) @map("is_featured")
  sortOrder    Int                  @default(0) @map("sort_order")
  lastUpdated  DateTime             @map("last_updated") @db.Date
  /// The member who opened the project (or was made leader); manages the team.
  leaderId     String?              @map("leader_id")
  leader       User?                @relation("leader", fields: [leaderId], references: [id], onDelete: SetNull)
  memberships  ProjectMembership[]
  invites      ProjectInvite[]
  datasets     Dataset[]
  /// Team size limit (members + open invites). Starts at 5, at most 10.
  slots        Int                  @default(5)
  slotRequests ProjectSlotRequest[]
  members      ProjectMember[]
  publications Publication[]
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isFeatured, sortOrder])
  @@map("projects")
}

/// Which team members work on which programme.
model ProjectMember {
  projectId    String     @map("project_id") @db.Uuid
  memberId     String     @map("member_id") @db.Uuid
  contribution String?
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member       TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([projectId, memberId])
  @@map("project_members")
}

/// Papers, datasets, code and briefs — with an honest status.
model Publication {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique
  title     String
  type      OutputType
  status    OutputStatus
  authors   String
  year      Int?
  venue     String?
  abstract  String
  url       String?
  pdfUrl    String?      @map("pdf_url")
  doi       String?
  /// Repository with the code behind the results.
  codeUrl   String?      @map("code_url")
  /// Where the data or replication package can be downloaded.
  dataUrl   String?      @map("data_url")
  /// Licence key from LICENCES in src/lib/citation.ts, e.g. "cc-by-4.0".
  licence   String?
  projectId String?      @map("project_id") @db.Uuid
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, year])
  @@map("publications")
}

/// News and updates. A null publishedAt means the post is a draft.
model NewsPost {
  id          String     @id @default(uuid()) @db.Uuid
  slug        String     @unique
  title       String
  excerpt     String
  body        String /// paragraphs separated by a blank line
  tags        String[]
  /// public: anyone; members: signed-in researchers only
  visibility  Visibility @default(members)
  publishedAt DateTime?  @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([publishedAt])
  @@map("news_posts")
}

/// A signed-in user's request to work with CAVALRY in a research field.
model Application {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id")
  user         User              @relation("applicant", fields: [userId], references: [id], onDelete: Cascade)
  field        String
  motivation   String
  background   String
  sampleUrl    String?           @map("sample_url")
  hoursPerWeek Int               @map("hours_per_week")
  status       ApplicationStatus @default(pending)
  reviewerId   String?           @map("reviewer_id")
  reviewer     User?             @relation("reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewNote   String?           @map("review_note")
  reviewedAt   DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([userId])
  @@map("applications")
}

/// A platform user working on a project, with a project-specific role.
model ProjectMembership {
  id        String          @id @default(uuid()) @db.Uuid
  projectId String          @map("project_id") @db.Uuid
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String          @map("user_id")
  user      User            @relation("membershipUser", fields: [userId], references: [id], onDelete: Cascade)
  /// Free-text role on the project (everyone has one, the leader too).
  role      String
  /// member or co_leader. The leader is projects.leader_id (never "leader" here).
  position  ProjectPosition @default(member)
  joinedAt  DateTime        @default(now()) @map("joined_at") @db.Timestamptz(6)
  /// Leader's 1–5 rating of this person's work on this project (null = not rated yet).
  rating    Int?
  ratedAt   DateTime?       @map("rated_at") @db.Timestamptz(6)
  ratedById String?         @map("rated_by_id")
  ratedBy   User?           @relation("ratedBy", fields: [ratedById], references: [id], onDelete: SetNull)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_memberships")
}

/// One-time invite link to join a project. Only a hash of the token is stored.
model ProjectInvite {
  id           String          @id @default(uuid()) @db.Uuid
  projectId    String          @map("project_id") @db.Uuid
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tokenHash    String          @unique @map("token_hash")
  role         String
  /// What the invitee becomes: member, co_leader, or leader (takes over the project).
  position     ProjectPosition @default(member)
  note         String?
  createdById  String?         @map("created_by_id")
  createdBy    User?           @relation("inviteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt    DateTime        @map("expires_at") @db.Timestamptz(6)
  acceptedById String?         @map("accepted_by_id")
  acceptedBy   User?           @relation("inviteAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt   DateTime?       @map("accepted_at") @db.Timestamptz(6)
  revokedAt    DateTime?       @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId])
  @@map("project_invites")
}

/// A dataset the research uses. With a project it is visible to that project's
/// team (and admins) only; without one it is shared with every member.
model Dataset {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  /// What the data is: source, coverage, version.
  description String
  /// What we use it for.
  usedFor     String    @map("used_for")
  /// GitHub, Google Drive or another https link.
  url         String
  projectId   String?   @map("project_id") @db.Uuid
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedById   String?   @map("added_by_id")
  addedBy     User?     @relation(fields: [addedById], references: [id], onDelete: SetNull)
  /// Listed in the public data catalogue (/data). Only admins publish, and
  /// never while the dataset's project is still in progress.
  isPublic    Boolean   @default(false) @map("is_public")
  /// Address of the public page, /data/<slug>. Set when first published.
  slug        String?   @unique
  /// Licence key from LICENCES in src/lib/citation.ts.
  licence     String?
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([projectId])
  @@index([isPublic])
  @@map("datasets")
}

/// People who signed up for email updates. Unsubscribing deletes the row.
model NewsletterSubscriber {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique
  /// Secret used in the unsubscribe link in every email.
  unsubscribeToken String   @unique @map("unsubscribe_token")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("newsletter_subscribers")
}

/// Better Auth sign-in/sign-up rate limits. Stored in the database so the
/// limits hold across Vercel's serverless instances.
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
}

enum ProjectPosition {
  member
  co_leader
  leader
}

enum SlotRequestStatus {
  pending
  approved
  declined
  cancelled
}

/// A leader asking an admin for more team slots on a project.
model ProjectSlotRequest {
  id            String            @id @default(uuid()) @db.Uuid
  projectId     String            @map("project_id") @db.Uuid
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedById String?           @map("requested_by_id")
  requestedBy   User?             @relation("slotRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  extra         Int
  reason        String
  status        SlotRequestStatus @default(pending)
  decidedById   String?           @map("decided_by_id")
  decidedBy     User?             @relation("slotDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?         @map("decided_at") @db.Timestamptz(6)
  adminNote     String?           @map("admin_note")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([projectId])
  @@index([status])
  @@map("project_slot_requests")
}
